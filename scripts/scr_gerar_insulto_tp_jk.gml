var r;
r = irandom(5);

switch (r) {
    case 0: msg_radio = "Piloto: 'Não toque nos meus dados com esse DNA de proveta.'"; break;
    case 1: msg_radio = "Engage Central: 'A General mandou o lixo pra torre de novo?'"; break;
    case 2: msg_radio = "Soldado: 'Vou conferir meus átomos. Odeio ser guiado por Cópias.'"; break;
    case 3: msg_radio = "Rádio: 'O modelo Jolyne Kujo não esconde sua falta de alma.'"; break;
    case 4: msg_radio = "Voz: 'Nordion Lands era melhor quando humanos operavam isso.'"; break;
    case 5: msg_radio = "Anon: 'Privilégio de laboratório... nepotismo sintético.'"; break;
}
